---
// Presentational frame around an interactive figure. The widget itself is imported
// statically by the section and passed in as a slot, because Astro can only generate a
// hydration script for a component it can trace to a real import: one resolved at runtime
// through import.meta.glob renders but never hydrates, however the glob is configured.
// That constraint is why title, caption and figure are authored in the section rather than
// exported by the widget module.
import { WidgetFrame } from '@prml/ui';

export interface Props {
  title: string;
  /** One sentence telling the reader what to *do* with this figure, not what it shows. */
  caption: string;
  /** Book figure this rebuilds, e.g. "3.7". */
  figure?: string;
}

const { title, caption, figure } = Astro.props;
---

<div class="widget-slot" data-pagefind-ignore>
  <WidgetFrame title={title} caption={caption} figure={figure}>
    <slot />
  </WidgetFrame>
</div>

<style>
  .widget-slot {
    margin-block: var(--prml-space-6);
  }
</style>
