---
import type { CollectionEntry } from 'astro:content';
import { sectionUrl } from '../layouts/routes';

export interface Props {
  current: string;
  chapter: CollectionEntry<'chapters'>;
  sections: CollectionEntry<'sections'>[];
}

const { current, chapter, sections } = Astro.props;
---

<nav aria-label={`Chapter ${chapter.data.number} sections`} class="rail-nav">
  <ol>
    {
      sections.map((s) => (
        <li>
          <a
            href={sectionUrl(s.data.section)}
            aria-current={s.data.section === current ? 'page' : undefined}
            data-section-id={s.data.section}
            class="rail-link"
          >
            <span class="rail-visited-mark" aria-hidden="true" />
            <span class="rail-number">{s.data.section}</span>
            <span class="rail-title">{s.data.title}</span>
          </a>
        </li>
      ))
    }
  </ol>
  <button type="button" class="rail-search" data-palette-trigger>
    <kbd>⌘K</kbd> Search
  </button>
</nav>

<script is:inline>
  try {
    var visitedRaw = localStorage.getItem('prml:visited');
    var visited = visitedRaw ? JSON.parse(visitedRaw) : [];
    if (Array.isArray(visited)) {
      visited.forEach(function (id) {
        var el = document.querySelector('.rail-link[data-section-id="' + id + '"]');
        if (el) el.classList.add('is-visited');
      });
    }
  } catch (err) {}
</script>

<style>
  .rail-nav {
    display: flex;
    flex-direction: column;
    gap: var(--prml-space-4);
  }

  ol {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: var(--prml-space-1);
  }

  .rail-link {
    display: flex;
    align-items: baseline;
    gap: var(--prml-space-2);
    padding: var(--prml-space-1) var(--prml-space-2);
    border-radius: var(--prml-radius-sm);
    text-decoration: none;
    color: var(--prml-color-ink-muted);
    font-family: var(--prml-font-sans);
    font-size: var(--prml-text-sm);
  }

  .rail-link:hover {
    background: var(--prml-color-sunken);
  }

  .rail-link[aria-current='page'] {
    background: var(--prml-color-accent-wash);
    color: var(--prml-color-ink);
    font-weight: var(--prml-weight-medium);
  }

  .rail-number {
    font-family: var(--prml-font-mono);
    font-size: var(--prml-text-xs);
    color: var(--prml-color-ink-faint);
  }

  .rail-visited-mark {
    width: var(--prml-space-2);
    height: var(--prml-space-2);
    border-radius: var(--prml-radius-pill);
    background: transparent;
    flex-shrink: 0;
  }

  .rail-link.is-visited .rail-visited-mark {
    background: var(--prml-color-success);
  }

  .rail-search {
    display: inline-flex;
    align-items: center;
    gap: var(--prml-space-2);
    border: 1px solid var(--prml-color-border);
    border-radius: var(--prml-radius-md);
    background: var(--prml-color-surface);
    color: var(--prml-color-ink-muted);
    font-family: var(--prml-font-sans);
    font-size: var(--prml-text-sm);
    padding: var(--prml-space-2) var(--prml-space-3);
    cursor: pointer;
  }
</style>
