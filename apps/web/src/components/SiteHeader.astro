---
import SearchButton from './SearchButton.astro';
import ThemeToggle from './ThemeToggle.astro';
---

<header class="site-header">
  <nav aria-label="Primary">
    <a class="brand" href="/">PRML Interactive</a>
    <ul class="primary-links">
      <li><a href="/map">Map</a></li>
      <li><a href="/review">Review</a></li>
      <li><a href="/equations">Equations</a></li>
      <li><a href="/figures">Figures</a></li>
    </ul>
    <div class="header-actions">
      <SearchButton />
      <ThemeToggle />
    </div>
  </nav>
</header>

<style>
  .site-header {
    border-bottom: 1px solid var(--prml-color-border);
    background: var(--prml-color-surface);
  }

  nav {
    max-width: var(--prml-layout-widget-width);
    margin-inline: auto;
    padding: var(--prml-space-3) var(--prml-space-4);
    display: flex;
    align-items: center;
    gap: var(--prml-space-5);
    flex-wrap: wrap;
  }

  .brand {
    font-family: var(--prml-font-sans);
    font-weight: var(--prml-weight-semibold);
    color: var(--prml-color-ink);
    text-decoration: none;
  }

  .primary-links {
    display: flex;
    gap: var(--prml-space-4);
    list-style: none;
    margin: 0;
    padding: 0;
    flex: 1;
  }

  .primary-links a {
    color: var(--prml-color-ink-muted);
    text-decoration: none;
    font-size: var(--prml-text-sm);
  }

  .primary-links a:hover {
    color: var(--prml-color-ink);
  }

  .header-actions {
    display: flex;
    align-items: center;
    gap: var(--prml-space-3);
  }
</style>
